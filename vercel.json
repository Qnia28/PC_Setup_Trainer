{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/game",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/game",
      "permanent": true
    },
    {
      "source": "/replay.html",
      "destination": "/replay",
      "permanent": true
    },
    {
      "source": "/licence.html",
      "destination": "/licence",
      "permanent": true
    },
    {
      "source": "/solver.html",
      "destination": "/solver",
      "permanent": true
    },
    {
      "source": "/sfinder.html",
      "destination": "/sfinder/chance",
      "permanent": true
    },
    {
      "source": "/sfinder",
      "destination": "/sfinder/chance",
      "permanent": true
    },
    {
      "source": "/setup_test.html",
      "destination": "/setup_test",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/game",
      "destination": "/index.html"
    },
    {
      "source": "/replay",
      "destination": "/replay.html"
    },
    {
      "source": "/licence",
      "destination": "/licence.html"
    },
    {
      "source": "/solver",
      "destination": "/solver.html"
    },
    {
      "source": "/sfinder/:command",
      "destination": "/sfinder.html"
    },
    {
      "source": "/replay/:id",
      "destination": "/replay.html"
    },
    {
      "source": "/setup_test",
      "destination": "/setup_test.html"
    }
  ]
}
